# Copy to .env (gitignored) and fill in. Never commit .env.

# Gmail account the application emails are sent from, and its 16-character App Password
# (myaccount.google.com -> Security -> 2-Step Verification -> App passwords). Not your login password.
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional: send DMs through the Telegram API instead of Telegram Web (my.telegram.org -> API development tools).
# Then log in once: .venv/bin/python scripts/send_telegram_dms.py --login
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
